# 複製這個檔案並改名為 .env，再填入你自己的設定（.env 不會被上傳到 GitHub）

# Gemini API Key：到 Google AI Studio（https://aistudio.google.com/apikey）免費申請
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.1-flash-lite

# MySQL 連線（先用 new.sql 建好資料庫）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=soulecho_db

# 後台（/admin）密碼：開啟後台時會詢問。留空 = 不檢查（只建議在自己電腦測試）
ADMIN_PASSWORD=change-me

# 選填：偵測到高風險內容時通知 Discord 頻道（留空 = 不發送）
DISCORD_WEBHOOK_URL=

# 伺服器設定：HOST=127.0.0.1 只有本機能連；要讓同 Wi-Fi 的手機連線改成 0.0.0.0
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
